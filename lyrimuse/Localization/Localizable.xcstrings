            "value" : "Kugou Musicのアルバムページ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kugou Music 앨범 페이지"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
