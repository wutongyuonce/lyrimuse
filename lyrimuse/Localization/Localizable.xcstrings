          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servicio push de código abierto. Instala ntfy en tu teléfono o tu Mac y suscríbete a un tema; sin registro, y puedes alojarlo tú mismo"
          }
        },
        "ja" : {
          "stringUnit" : {
