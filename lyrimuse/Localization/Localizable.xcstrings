    "连续混音版，与原版编排不同" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuous mix, arranged differently from the original"
          }
        },
        "es" : {
          "stringUnit" : {
