    "按 MusicBrainz 登记的所属国家或地区统计，而非出生地" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted by the country or region each artist is associated with on MusicBrainz, not where they were born"
          }
        },
