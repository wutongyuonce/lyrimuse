          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ lost %2$d point on this term and the winner did not; the entire %3$d-point gap comes from it"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ lost %2$d points on this term and the winner did not; the entire %3$d-point gap comes from it"
