        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 재생 포커스를 사용 중이므로 ‘%@’을(를) 제어할 수 없습니다"
          }
        },
        "zh-Hans" : {
