        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタがノッチ上にあるとき、2本指で左右にスワイプすると曲を切り替え、上下にスワイプすると音量を調整します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 노치 위에 있을 때 두 손가락으로 왼쪽이나 오른쪽으로 쓸어 넘기면 노래를 바꾸고, 위아래로 쓸어 넘기면 음량을 조절합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
