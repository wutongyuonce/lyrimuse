      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the Bark app on your iPhone — the home screen shows your personal push URL. Just copy and paste it here; no extra setup needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala la app Bark en tu iPhone; la pantalla de inicio muestra tu URL push personal. Cópiala y pégala aquí, no hace falta configurar nada más"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneにBark Appをインストールすると、ホーム画面に専用のプッシュURLが表示されます。それをコピーしてここに貼り付けるだけで、追加の設定は不要です"
