            "value" : "連続ミックス版で、原曲とアレンジが異なります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연속 믹스 버전으로 원곡과 편곡이 다릅니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
