        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 正佔用播放焦點，暫時無法控制「%@」"
          }
        }
      }
    },
    "其他 App 正占用播放焦点，暂时无法控制播放" : {
