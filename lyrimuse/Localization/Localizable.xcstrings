    "逐字歌词仅修改文字，每个字保留原有时间；新增或修改了时间戳的句子按字数分配时间" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word-by-word lyrics: edit the text only. Every word keeps its timing; new lines and lines with a changed timestamp get their time split evenly by length"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letra palabra por palabra: edita solo el texto. Cada palabra conserva su tiempo; las líneas nuevas o con la marca de tiempo modificada reparten el tiempo según su longitud"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語ごとの歌詞はテキストのみを編集し、各単語は元のタイミングを保持します。追加した行やタイムスタンプを変更した行は、文字数に応じてタイミングを割り当てます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어별 가사는 텍스트만 수정하며 각 단어의 기존 타이밍은 유지됩니다. 새로 추가했거나 타임스탬프를 수정한 줄은 글자 수에 따라 시간이 분배됩니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字歌词仅修改文字，每个字保留原有时间；新增或修改了时间戳的句子按字数分配时间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字歌詞僅修改文字，每個字保留原有時間；新增或修改了時間戳記的句子按字數分配時間"
          }
        }
      }
    },
