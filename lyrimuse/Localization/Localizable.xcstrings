    "仅部分专辑提供；低电量或「减弱动态效果」时自动暂停" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available on some albums only; pauses in Low Power Mode or with Reduce Motion on"
