          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상단 정보 영역이 차지하는 윈도우 높이의 비율입니다(제목, 아티스트, 시간 세 줄이 모두 표시된 경우 기준). 글자 크기와 아트워크가 비례하여 조절됩니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頂部資訊區佔視窗高度的百分比（按歌名、歌手、時間三行均顯示計算），字級與封面等比縮放"
